# These should point at the Neon "development" branch, never at production
# (see docs/adr/0014-separate-dev-test-database-branch.md). Production's
# values live in Vercel's Production environment settings (the only place
# the live app reads them from) and, for the one-off `migrate:production`
# script only (see docs/requirements/11-production-deployment-pipeline.md
# and docs/adr/0019-local-production-credentials-and-automated-migrations.md),
# in a separate, gitignored .env.production.local -- never in this file.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Non-pooled connection, used only by Prisma Migrate (see docs/adr/0003-postgres-database-via-neon.md)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
