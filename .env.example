# These should point at the Neon "development" branch, never at production
# (see docs/adr/0014-separate-dev-test-database-branch.md). Production's
# values live in Vercel's Production environment settings (the only place
# the live app reads them from) and, for the one-off `migrate:production`
# script only (see docs/requirements/infrastructure-deployment/11-production-deployment-pipeline.md
# and docs/adr/0019-local-production-credentials-and-automated-migrations.md),
# in a separate, gitignored .env.migrate-production.local -- never in this
# file. Deliberately NOT named .env.production.local: Next.js auto-loads
# that exact filename during any local `next build`/`next start`, which
# would silently point a local run at production.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Non-pooled connection, used only by Prisma Migrate (see docs/adr/0003-postgres-database-via-neon.md)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Used only to classify an ingredient's grocery category when it's first
# added (see docs/requirements/printing-exports/12-menu-print-preview.md and the AI-service
# ADR it calls for). Not a database credential -- a different kind of
# secret this app didn't need before. If unset or invalid, classification
# silently falls back to a built-in keyword heuristic rather than failing.
ANTHROPIC_API_KEY="sk-ant-..."

# Used only as transient transport for the PDF/Excel campout-import upload
# (see docs/requirements/data-import/30-campout-import-from-pdf-excel.md and
# docs/adr/0032-campout-import-blob-upload-transport.md) -- the file is
# uploaded straight from the browser to Vercel Blob and deleted again right
# after the server reads it, never kept as persistent storage. Get this by
# creating a Blob store in the Vercel dashboard (Storage tab) for this
# project; it's auto-added to Vercel's own Production/Preview/Development
# environments, but still needs pulling down locally (`vercel env pull
# .env.development.local`, or copy it by hand from the dashboard) for the
# import feature to work in local dev. Without it, uploads fail with a
# clear "Invalid upload" error rather than a silent crash.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
