generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PatrolType {
  YOUTH
  ADULT
}

model Patrol {
  id                      String                   @id @default(cuid())
  name                    String
  color                   String
  icon                    String?
  order                   Int
  type                    PatrolType               @default(YOUTH)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  menus                   Menu[]
  mealFrameworkExceptions MealFrameworkException[]
  // REQ-34.2: a Patrol Leader's membership points here (formerly
  // User.patrolId, ADR 0033's interim placement -- moved by ADR 0035).
  memberships             UnitMembership[]
  invitations             UnitInvitation[]
}

enum MealOccasion {
  FRIDAY_CRACKER_BARREL
  SATURDAY_BREAKFAST
  SATURDAY_LUNCH
  SATURDAY_DINNER
  SATURDAY_CRACKER_BARREL
  SUNDAY_BREAKFAST
}

enum MenuStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

model Campout {
  id                      String                   @id @default(cuid())
  name                    String
  date                    DateTime
  // REQ-30: the campout's last day, for a multi-day span (e.g. Fri-Sun) --
  // null means single-day, same as every campout before this column
  // existed. See ADR 0030.
  endDate                 DateTime?
  location                String?
  description             String?
  imageUrl                String?
  // REQ-30: provenance only, not an audit trail -- overwritten on every
  // subsequent upload, so it answers "was this last touched by an
  // upload" rather than "show its full upload history." See ADR 0030.
  lastUploadedFrom        String?
  lastUploadedAt          DateTime?
  createdAt               DateTime                 @default(now())
  menus                   Menu[]
  mealFrameworkExceptions MealFrameworkException[]
}

// REQ-30: a short-lived staging row holding one upload's proposed
// campouts (post-match, pre-ASPL-edit) between "upload" and "confirm" --
// a real table rather than a session store or a signed hidden-form
// payload, since this app has no session infra and `candidates` can carry
// multi-KB base64 thumbnail data per row. Deleted on confirm; swept
// lazily (by age) on the next upload rather than via a cron job. See ADR
// 0031.
model CampoutUploadBatch {
  id             String   @id @default(cuid())
  sourceFileName String
  createdAt      DateTime @default(now())
  candidates     Json
}

model Menu {
  id              String            @id @default(cuid())
  campoutId       String
  campout         Campout           @relation(fields: [campoutId], references: [id])
  patrolId        String
  patrol          Patrol            @relation(fields: [patrolId], references: [id])
  dueDate         DateTime
  status          MenuStatus        @default(NOT_STARTED)
  // REQ-25.1: set once, on the first NOT_STARTED/IN_PROGRESS -> SUBMITTED
  // transition only (see submitMenu in app/(app)/menus/[id]/actions.ts) --
  // never overwritten by a later Changes-Requested resubmission, so it
  // always reflects the *first* submission, which is what the on-time
  // streak (lib/streaks.ts) compares against dueDate. See ADR 0028.
  submittedAt     DateTime?
  nutritionNote   String            @default("")
  allergyNote     String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  meals           Meal[]
  reviews         Review[]
  comments        Comment[]
  commentActivity CommentActivity[]

  @@unique([campoutId, patrolId])
}

model Meal {
  id       String       @id @default(cuid())
  menuId   String
  menu     Menu         @relation(fields: [menuId], references: [id])
  occasion MealOccasion
  dishes   Dish[]

  @@unique([menuId, occasion])
}

model Dish {
  id          String       @id @default(cuid())
  mealId      String
  meal        Meal         @relation(fields: [mealId], references: [id])
  name        String
  ingredients Ingredient[]
  comments    Comment[]
}

// A patrol-leader-entered free-text item, never tagged by hand with a
// category — `category` is inferred automatically (REQ-12.9/12.10) and
// cached per distinct ingredient name, not re-classified per row. Null
// means "not yet classified" (e.g. pre-existing rows from before this
// column existed) and is treated identically to OTHER wherever it's
// displayed, never as an error state.
model Ingredient {
  id       String              @id @default(cuid())
  dishId   String
  dish     Dish                @relation(fields: [dishId], references: [id])
  name     String
  quantity String
  category IngredientCategory?
  comments Comment[]
}

enum IngredientCategory {
  PRODUCE
  MEAT_PROTEIN
  DAIRY_EGGS
  BREAD_BAKERY
  PANTRY_DRY_GOODS
  CONDIMENTS_SAUCES
  SPICES_SEASONINGS
  FROZEN
  BEVERAGES
  OTHER
}

model Review {
  id        String         @id @default(cuid())
  menuId    String
  menu      Menu           @relation(fields: [menuId], references: [id])
  decision  ReviewDecision
  comment   String?
  createdAt DateTime       @default(now())
}

// REQ-26: the two parties who can ever author/assign/resolve/delete a
// comment -- the same two roles `lib/session.ts`'s `Actor` type already
// models. Not a general user-identity system; see ADR 0026.
enum CommentActorRole {
  ASPL
  PATROL_LEADER
}

enum CommentTargetType {
  MENU
  DISH
  INGREDIENT
  MEAL
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum CommentActivityAction {
  CREATED
  REPLIED
  ASSIGNED
  REASSIGNED
  RESOLVED
  REOPENED
  DELETED
}

// REQ-26: a general-purpose, Office-review-mode-style annotation layer
// alongside Review (ADR 0007) -- comments never drive Menu.status. A reply
// is a Comment row with `parentId` set, flat (one level, no reply-to-
// reply), inheriting its root's target.
//
// `targetType` is stored explicitly rather than inferred from
// dishId/ingredientId nullability, because those two FKs are `onDelete:
// SetNull` (removeDish/removeIngredient in actions.ts hard-delete the
// underlying row) -- once that happens, nullability alone could no longer
// distinguish a DISH comment whose dish is gone from a MENU comment.
// `targetLabel` is a point-in-time name snapshot for the same reason: the
// comment (and REQ-26.6's audit log) must keep reading sensibly forever,
// even after its anchor is renamed or removed. See ADR 0026.
model Comment {
  id                 String            @id @default(cuid())
  menuId             String
  menu               Menu              @relation(fields: [menuId], references: [id])
  targetType         CommentTargetType
  dishId             String?
  dish               Dish?             @relation(fields: [dishId], references: [id], onDelete: SetNull)
  ingredientId       String?
  ingredient         Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  // REQ-29.3/29.7: a MEAL comment anchors on menuId + occasion, not a
  // `Meal` FK -- restoreOccasion (app/(app)/campouts/[id]/actions.ts)
  // creates a brand-new Meal row with a new id on every restore, so an FK
  // (even `onDelete: SetNull`, matching dishId/ingredientId) would leave a
  // comment permanently detached after one remove/restore cycle. Since a
  // menu has at most one Meal per occasion, the (menuId, occasion) pair
  // already identifies "that meal" uniquely and keeps working across
  // delete/recreate. See ADR 0029.
  occasion           MealOccasion?
  targetLabel        String?
  parentId           String?
  parent             Comment?          @relation("CommentReplies", fields: [parentId], references: [id])
  replies            Comment[]         @relation("CommentReplies")
  body               String
  authorRole         CommentActorRole
  authorPatrolId     String?
  status             CommentStatus     @default(OPEN)
  assigneeRole       CommentActorRole?
  assigneePatrolId   String?
  resolvedAt         DateTime?
  resolvedByRole     CommentActorRole?
  resolvedByPatrolId String?
  deletedAt          DateTime?
  deletedByRole      CommentActorRole?
  deletedByPatrolId  String?
  createdAt          DateTime          @default(now())
  activity           CommentActivity[]
}

// REQ-26.6: an append-only, immutable audit trail -- deleting a Comment is
// always a soft delete (Comment.deletedAt), so a comment's activity rows
// are never deleted either. `targetSummary`/`detail` are frozen display
// text captured at write time, not derived live, so a past entry reads
// correctly even after the comment/dish/ingredient it describes changes.
model CommentActivity {
  id            String                @id @default(cuid())
  menuId        String
  menu          Menu                  @relation(fields: [menuId], references: [id])
  commentId     String
  comment       Comment               @relation(fields: [commentId], references: [id])
  action        CommentActivityAction
  actorRole     CommentActorRole
  actorPatrolId String?
  targetSummary String
  detail        String?
  createdAt     DateTime              @default(now())
}

// A row means "this occasion is removed for this patrol (or every patrol,
// if patrol is null) on this campout." No DB-level unique constraint: Postgres
// treats NULL as distinct in uniqueness, so it can't dedupe the "all patrols"
// case — app code (removeOccasion) does deleteMany-then-create for the exact
// same scope instead, as an app-level upsert. See ADR 0012.
model MealFrameworkException {
  id        String       @id @default(cuid())
  campoutId String
  campout   Campout      @relation(fields: [campoutId], references: [id])
  patrolId  String?
  patrol    Patrol?      @relation(fields: [patrolId], references: [id])
  occasion  MealOccasion
  createdAt DateTime     @default(now())
}

// ============================================================
// REQ-31: real accounts & sessions, replacing ADR 0010's cookie-
// only Actor. See ADR 0033. User/Session/Account/Verification are
// Better Auth's own standard schema (field names/shapes are its
// contract with the Prisma adapter, not this project's choice to
// vary); Passkey is its passkey plugin's schema, same rule. Only the
// relation fields and Session.createdVia/activeUnitId are ScoutBuddy's own
// additions.
// ============================================================

model User {
  id            String      @id @default(cuid())
  name          String
  email         String?     @unique
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  authEvents    AuthEvent[]

  // REQ-34.2: role and patrol are per-unit, on UnitMembership. They lived
  // directly on User as ADR 0033's interim single-unit placement until
  // ADR 0035 moved them.
  memberships     UnitMembership[]
  invitationsSent UnitInvitation[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // REQ-31.6/32.2: which credential established this session --
  // "passkey" (standing, full assurance) or "magic-link" (bootstrap/
  // recovery tier, step-up required before anything sensitive). Set in
  // lib/auth.ts's databaseHooks.session.create.before from the request
  // path, not inferred later -- the path that created the session is only
  // known at that moment.
  createdVia String?

  // REQ-34.3: the unit this session is acting in. Never trusted on its
  // own -- lib/session.ts revalidates it against the user's actual
  // UnitMembership rows on every request, and re-resolves (and rewrites)
  // it when it's missing, stale, or points at a unit they were removed
  // from (REQ-34.8). No foreign key on purpose: a dangling value is
  // exactly the case re-resolution exists to handle.
  activeUnitId String?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

// REQ-31.7: Better Auth's own database-backed rate-limit counters
// (`rateLimit.storage: "database"` in lib/auth.ts) -- "database", not the
// default "memory", because Vercel's serverless functions don't share
// memory across invocations; an in-memory counter would silently do
// nothing in production. Field shape is Better Auth's own contract
// (key/count/lastRequest, the last as an epoch-ms number, not a DateTime),
// not this project's naming convention to vary.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// REQ-31.10: security-relevant auth events, logged without ever storing a
// credential/token value -- failed sign-ins, lockout triggers, credential
// changes. `identifier` (the email/username attempted) is kept alongside
// `userId` since a failed sign-in for an unrecognized account has no user
// row to attach to yet; REQ-31.7's per-account rate limiting queries this
// table by `identifier` directly, not by userId alone.
model AuthEvent {
  id         String   @id @default(cuid())
  type       String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  identifier String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([identifier, createdAt])
}

// ============================================================
// REQ-34: units, the Scouting America hierarchy above them, and who
// belongs to which. See ADR 0035. National is implicit (exactly one,
// Scouting America) and isn't stored. Council and District are shared
// reference data, not scoped to any one unit (REQ-27.2).
// ============================================================

enum UnitType {
  PACK
  TROOP
  CREW
  SHIP
  POST
}

// REQ-34.16: required on every unit. Exists because a linked pair of
// single-gender Packs or Troops can share a unit number in one district.
enum GenderDesignation {
  BOYS
  GIRLS
  FAMILY
}

// REQ-34.2: a role is held per unit, not per account -- the same person
// can be the ASPL in one unit and a Patrol Leader in another.
enum UnitRole {
  ASPL
  PATROL_LEADER
}

// REQ-34.5: every membership is traceable to how it was created. MIGRATION
// marks only the rows ADR 0035's migration backfilled from the pre-unit
// User.role/patrolId columns; every membership created afterwards is
// INVITATION, with invitationId set.
enum UnitMembershipSource {
  INVITATION
  MIGRATION
}

// REQ-34.14: keyed by Scouting America's council number, not its name --
// names change (renames, mergers); the number doesn't. Seeded from a
// reference list by ADR 0035's migration. isActive=false is how a council
// emptied by a merger is retired (REQ-34.10): kept for history, hidden from
// lookup, never deleted.
model Council {
  id        String     @id @default(cuid())
  number    Int        @unique
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  districts District[]
}

// REQ-34.10: identified by id, never by name -- districts are renamed and
// realigned. normalizedName (lowercased, whitespace-collapsed; see
// lib/units.ts's normalizeDistrictName) is what uniqueness within a council
// is checked against, so "Pathfinder District" and "pathfinder  district"
// can't both exist.
model District {
  id             String   @id @default(cuid())
  councilId      String
  council        Council  @relation(fields: [councilId], references: [id])
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  units          Unit[]

  @@unique([councilId, normalizedName])
}

// REQ-34.1: no stored display name -- "Troop 8 (Boys)" is derived from
// these fields (lib/units.ts), so the two can never disagree. A unit's
// council is always reached through its district, never stored here.
// unitNumber is also CHECK-constrained to 1-9999 in the migration SQL.
model Unit {
  id                String            @id @default(cuid())
  unitType          UnitType
  unitNumber        Int
  genderDesignation GenderDesignation
  districtId        String
  district          District          @relation(fields: [districtId], references: [id])
  createdAt         DateTime          @default(now())
  memberships       UnitMembership[]
  invitations       UnitInvitation[]
  events            UnitEvent[]

  // REQ-34.11: unique per district. Every column is required, so there's
  // no NULL-distinctness gap in this constraint.
  @@unique([districtId, unitType, unitNumber, genderDesignation])
}

model UnitMembership {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  role         UnitRole
  // Set only for a Patrol Leader. SetNull on patrol deletion leaves a
  // Patrol Leader membership with no patrol, which lib/session.ts treats as
  // no access in that unit -- same outcome REQ-8.14's deleted-patrol check
  // produced when this lived on User.
  patrolId     String?
  patrol       Patrol?              @relation(fields: [patrolId], references: [id], onDelete: SetNull)
  source       UnitMembershipSource
  invitationId String?              @unique
  invitation   UnitInvitation?      @relation(fields: [invitationId], references: [id])
  createdAt    DateTime             @default(now())

  @@unique([userId, unitId])
  @@index([unitId])
}

// REQ-34.5/34.7: email-bound, single-use, expiring. Only a SHA-256 hash of
// the token is stored -- the token itself exists only in the emailed link,
// so neither this row's id nor a database read is enough to accept it.
model UnitInvitation {
  id          String          @id @default(cuid())
  unitId      String
  unit        Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  email       String
  role        UnitRole
  patrolId    String?
  patrol      Patrol?         @relation(fields: [patrolId], references: [id], onDelete: SetNull)
  tokenHash   String          @unique
  expiresAt   DateTime
  invitedById String?
  invitedBy   User?           @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime        @default(now())
  membership  UnitMembership?

  @@index([unitId])
}

// REQ-34.8 (and the moves REQ-34.10 logs, once built): who did what to a
// unit's membership, and when. User ids are plain strings, not foreign
// keys, so the log outlives the accounts it mentions (Requirement 35).
model UnitEvent {
  id            String   @id @default(cuid())
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type          String
  actorUserId   String?
  subjectUserId String?
  detail        String?
  createdAt     DateTime @default(now())

  @@index([unitId, createdAt])
}
